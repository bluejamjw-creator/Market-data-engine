# Copy to .env for local development. Never commit real values.
DATABASE_URL=postgresql://user:password@localhost:5432/market_data
TZ=Europe/London
PYTHONUNBUFFERED=1
TWELVE_DATA_API_KEY=
ALPHA_VANTAGE_API_KEY=
COINMARKETCAP_API_KEY=

# Optional
# ADMIN_TOKEN=            # enables POST /admin/scan when set
# MDE_DISABLE_SCHEDULER=1 # do not start the scheduler or the startup scan
# MDE_STARTUP_SCAN_MAX_AGE_HOURS=6
# MDE_COST_PCT_US=0.10
# MDE_COST_PCT_UK=0.60
# MDE_COST_PCT_EU=0.25
# MDE_COST_PCT_CRYPTO=0.50
